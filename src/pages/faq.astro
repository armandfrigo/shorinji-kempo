---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="de">
    <div class="container">
        <h1>Häufige Fragen (FAQ)</h1>
        <p>Diese Seite wird ergänzt. Bei Fragen erreichen Sie uns unter <a href="mailto:marco.pellegrino@shorinjikempo.ch">marco.pellegrino@shorinjikempo.ch</a>.</p>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1 {
        margin-bottom: 1rem;
        color: #111;
    }
    p {
        color: #333;
        line-height: 1.6;
    }
    a {
        color: #c00;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>
