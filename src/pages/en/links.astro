---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui.ts';

const t = ui.en || ui.de;
---

<Layout lang='en'>
    <div class="container">
        <h1>Links</h1>
        
        <div class="links-section">
            <h2>WSKO</h2>
            <p><a href="https://www.shorinjikempo.or.jp/wsko/" target="_blank">World Shorinji Kempo Organization</a></p>
            <p>To study Shorinji Kempo, you must join a branch that is a member of the World Shorinji Kempo Organization. You must also become a WSKO member.</p>
            <p>Contact the national association office or the branch.</p>
        </div>

        <div class="links-section">
            <h2>Visit us on Facebook</h2>
            <p><a href="https://www.facebook.com/ShorinjiKempoSchweiz/" target="_blank">Shorinji Kempo Switzerland</a></p>
        </div>

        <div class="links-section">
            <h2>Legal</h2>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/impressum/" target="_blank">Imprint</a></p>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/datenschutzerklaerung/" target="_blank">Privacy Policy</a></p>
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1, h2 {
        margin-bottom: 1rem;
        color: #111;
    }
    .links-section {
        margin-bottom: 2rem;
        padding: 1rem;
        border-left: 3px solid #c00;
        background: #f9f9f9;
    }
    a {
        color: #c00;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>