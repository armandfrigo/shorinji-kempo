---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui.ts';

const t = ui.de || ui.de;
---

<Layout lang='de'>
    <div class="container">
        <h1>Aktuell</h1>
        
        <article class="news-item">
            <img src="/images/ATT45591.jpg" alt="Schwarzgurttrainings 2026" />
            <div class="news-content">
                <h2>Schwarzgurttrainings 2026</h2>
                <p class="meta">Von Silvan Buchecker | 3. November 2025</p>
                <p>Die Schwarzgurttrainings finden im Jahr 2026 an den folgenden Daten statt: Achtung! Wir sind umgezogen. Das Dojo Basel befindet sich nun am Winkelriedplatz 6, 4053 Basel. Die Schwarzgurttrainings kosten 20 CHF pro Kenshi.</p>
            </div>
        </article>

        <article class="news-item">
            <img src="/images/IMG-20250602-WA0018-1-1024x768.jpg" alt="Taikai Portugal" />
            <div class="news-content">
                <h2>Schweizer Delegation am Taikai in Portugal</h2>
                <p class="meta">Von Silvan Buchecker | 3. November 2025</p>
                <p>Eine Schweizer Delegation hat am Taikai am 23. bis 25. Oktober in Lissabon teilgenommen. Die dreitägige Trainingsveranstaltung wurde anlässlich des 50-Jahr-Jubiläums von Shorinji Kempo Portugal veranstaltet.</p>
            </div>
        </article>

        <article class="news-item">
            <img src="/images/Gruppe_5-1-768x512.jpeg" alt="Japanfest Bern" />
            <div class="news-content">
                <h2>Japanfest Bern 22.05.2022</h2>
                <p class="meta">Von Silvan Buchecker | 24. Mai 2022</p>
                <p>Am 22. Mai 2022 hat Dojo Muri, mit Unterstützung von Dojo Basel und Dojo Aubonne, die Möglichkeit, sich beim Japanfest (Historisches Museum Bern) durch einen Workshop zu präsentieren.</p>
            </div>
        </article>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1 {
        margin-bottom: 2rem;
        color: #111;
    }
    .news-item {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid #ddd;
        padding-bottom: 2rem;
    }
    .news-item img {
        width: 150px;
        height: 100px;
        object-fit: cover;
        border-radius: 4px;
    }
    .news-content h2 {
        margin: 0 0 0.5rem 0;
        color: #c00;
    }
    .meta {
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.5rem;
    }
</style>