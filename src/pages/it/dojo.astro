---
import Layout from '../../layouts/Layout.astro';
import InstagramLink from '../../components/InstagramLink.astro';
import { ui } from '../../i18n/ui.ts';
import { withBase } from '../../utils/paths.ts';

const t = ui.it || ui.de;
const imgBasel = withBase('/uploads/2025/01/IMG_0737-rotated.jpg');
const imgAubonne = withBase('/uploads/2026/05/IMG_7175.jpeg');
const imgMuri = withBase('/uploads/bb-plugin/cache/Dojo-Muri-landscape-7f9d8d7f06ff5d56f08f7f0bb52a757e-5d849ada2e833.jpeg');
---

<Layout lang='it'>
    <div class="container">
        <h1>Dojos</h1>
        
        <h2>Basilea</h2>
        <div class="dojo-card">
            <img src={imgBasel} alt="Dojo Basilea" />
            <div class="dojo-info">
                <p><strong>Luogo e orario</strong></p>
                <p>Winkelriedplatz 6<br>CH-4053 Basilea</p>
                <p>Martedì 19:00 – 21:00</p>
                <p><strong>Istruttore:</strong> Marco Pellegrino (5° Dan)</p>
                <p><strong>Telefono:</strong> +41 79 636 56 82</p>
                <p><strong>Email:</strong> marco.pellegrino@shorinjikempo.ch</p>
            </div>
        </div>

        <InstagramLink href="https://www.instagram.com/shorinjikempo.basel/" label="Basel" />

        <h2>Aubonne</h2>
        <div class="dojo-card">
            <img src={imgAubonne} alt="Dojo Aubonne" />
            <div class="dojo-info">
                <p><strong>Indirizzo e orari</strong></p>
                <p>Collège du Chêne, Salle de rythmique,<br>
                Avenue du Mont-Blanc 53<br>
                CH-1170 Aubonne</p>
                <p>Orari:<br>- martedì 19:00 – 20:30</p>
                <p><strong>Istruttore:</strong> Roberto Comino (4° Dan)</p>
                <p><strong>Email:</strong> comino.roberto@gmail.com</p>
            </div>
        </div>

        <InstagramLink href="https://www.instagram.com/shorinjikempo.aubonne/" label="Aubonne" />

        <h2>Muri (bambini)</h2>
        <div class="dojo-card">
            <img src={imgMuri} alt="Dojo Muri" />
            <div class="dojo-info">
                <p><strong>Luogo e orario per bambini</strong></p>
                <p>MüZe Familien- und Weiterbildungszentrum<br>
                Kranichweg 10<br>
                3074 Muri vicino Berna</p>
                <p>Giovedì 16:20-17:00</p>
                <p><strong>Istruttrice:</strong> Tomoko Muth-Akao (4° Dan)</p>
                <p><strong>Email:</strong> tomoko.muth@shorinjikempo.ch</p>
            </div>
        </div>

        <InstagramLink href="https://www.instagram.com/shorinjikempo.muri/" label="Muri" />
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1, h2 {
        margin-bottom: 1rem;
        color: #111;
    }
    h2 {
        margin-top: 2rem;
    }
    .dojo-card {
        display: flex;
        gap: 2rem;
        margin-bottom: 2rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }
    .dojo-card img {
        width: 200px;
        height: 150px;
        object-fit: cover;
    }
    .dojo-info {
        padding: 1rem;
    }
</style>