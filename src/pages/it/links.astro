---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui.ts';

const t = ui.it || ui.de;
---

<Layout lang='it'>
    <div class="container">
        <h1>Link</h1>
        
        <div class="links-section">
            <h2>WSKO</h2>
            <p><a href="https://www.shorinjikempo.or.jp/wsko/" target="_blank">World Shorinji Kempo Organization</a></p>
            <p>Per studiare lo Shorinji Kempo, devi aderire a una filiale che è membro della World Shorinji Kempo Organization. Devi anche diventare membro della WSKO.</p>
            <p>Contatta l'ufficio della federazione nazionale o la filiale.</p>
        </div>

        <div class="links-section">
            <h2>Visitanoci su Facebook</h2>
            <p><a href="https://www.facebook.com/ShorinjiKempoSchweiz/" target="_blank">Shorinji Kempo Svizzera</a></p>
        </div>

        <div class="links-section">
            <h2>Informazioni legali</h2>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/impressum/" target="_blank">Impressum</a></p>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/datenschutzerklaerung/" target="_blank">Informativa sulla privacy</a></p>
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1, h2 {
        margin-bottom: 1rem;
        color: #111;
    }
    .links-section {
        margin-bottom: 2rem;
        padding: 1rem;
        border-left: 3px solid #c00;
        background: #f9f9f9;
    }
    a {
        color: #c00;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>