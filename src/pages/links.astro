---
import Layout from '../layouts/Layout.astro';
import { ui } from '../i18n/ui.ts';
import { withBase } from '../utils/paths.ts';

const t = ui.de || ui.de;
const wskoImg = withBase('/uploads/2019/09/img-720152649-0001-1024x708.jpg');
---

<Layout lang='de'>
    <div class="container">
        <h1>Weitere Links</h1>

        <div class="links-section links-section--wsko">
            <img
                class="links-wsko-img"
                src={wskoImg}
                alt=""
                width="1024"
                height="708"
                loading="lazy"
            />
            <h2>WSKO</h2>
            <p class="links-wsko-title">World Shorinji Kempo Organization</p>
            <p>Um Shorinji Kempo zu studieren, müssen Sie einer Niederlassung beitreten, die Mitglied der World Shorinji Kempo Organization ist. Zudem müssen Sie WSKO-Mitglied werden.</p>
            <p>Wenden Sie sich an das Sekretariat des nationalen Verbandes oder an die Niederlassung.</p>
            <p><a href="https://www.shorinjikempo.or.jp/wsko/" target="_blank" rel="noopener noreferrer">Weiter zur WSKO</a></p>
        </div>

        <div class="links-section">
            <h2>Besuchen Sie uns auf Facebook</h2>
            <p><a href="https://www.facebook.com/ShorinjiKempoSchweiz/" target="_blank">Shorinji Kempo Schweiz</a></p>
        </div>

        <div class="links-section">
            <h2>Rechtliches</h2>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/impressum/" target="_blank">Impressum</a></p>
            <p><a href="https://shorinjikempo.ch/index.php/startseite/datenschutzerklaerung/" target="_blank">Datenschutzerklärung</a></p>
        </div>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1, h2 {
        margin-bottom: 1rem;
        color: #111;
    }
    .links-section {
        margin-bottom: 2rem;
        padding: 1rem;
        border-left: 3px solid #c00;
        background: #f9f9f9;
    }
    .links-wsko-img {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
        margin-bottom: 1rem;
    }
    .links-wsko-title {
        font-weight: 600;
        margin-top: 0;
    }
    a {
        color: #c00;
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
</style>