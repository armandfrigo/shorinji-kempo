---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui';
import { withBase, localizePath } from '../../utils/paths.ts';

const lang = 'fr';
const meta = ui[lang];
const imgBasel = withBase('/uploads/2025/01/IMG_0737-rotated.jpg');
const imgAubonne = withBase('/uploads/2026/05/IMG_7175.jpeg');
const imgMuri = withBase('/images/Dojo-Muri-landscape-7f9d8d7f06ff5d56f08f7f0bb52a757e-5d849ada2e833.jpg');
---

<Layout lang="fr" title={meta['seo.dojoTitle']} description={meta['seo.dojoDescription']}>
    <div class="container">
        <h1>Dojos</h1>
        
        <h2>Basel</h2>
        <div class="dojo-card">
            <img src={imgBasel} alt="Dojo Basel" />
            <div class="dojo-info">
                <p><strong>Lieu et horaire d'entraînement</strong></p>
                <p>Winkelriedplatz 6<br>CH-4053 Bâle</p>
                <p>Mardi 19h00 – 21h00</p>
                <p><strong>Instructeur:</strong> Marco Pellegrino (5ème Dan)</p>
                <p><strong>Téléphone:</strong> +41 79 636 56 82</p>
                <p><strong>Email:</strong> marco.pellegrino@shorinjikempo.ch</p>
            </div>
        </div>

        <p class="mt-2">
            <a class="dojo-detail-link" href={localizePath('/basel', lang)}>En savoir plus sur le dojo de Bâle →</a>
        </p>

        <h2>Aubonne</h2>
        <div class="dojo-card">
            <img src={imgAubonne} alt="Dojo Aubonne" />
            <div class="dojo-info">
                <p><strong>Adresse et horaire</strong></p>
                <p>Collège du Chêne, Salle de rythmique,<br>
                Avenue du Mont-Blanc 53<br>
                CH-1170 Aubonne</p>
                <p>Horaire:<br>- les mardis de 19h00 à 20h30</p>
                <p><strong>Instructeur:</strong> Roberto Comino (4ème Dan)</p>
                <p><strong>Email:</strong> comino.roberto@gmail.com</p>
            </div>
        </div>

        <p class="mt-2">
            <a class="dojo-detail-link" href={localizePath('/aubonne', lang)}>En savoir plus sur le dojo d'Aubonne →</a>
        </p>

        <h2>Muri (enfants)</h2>
        <div class="dojo-card">
            <img src={imgMuri} alt="Dojo Muri" />
            <div class="dojo-info">
                <p><strong>Lieu et horaire pour enfants</strong></p>
                <p>MüZe Familien- und Weiterbildungszentrum<br>
                Kranichweg 10<br>
                3074 Muri près de Berne</p>
                <p>Jeudi 16h20-17h00</p>
                <p><strong>Instructrice:</strong> Tomoko Muth-Akao (4ème Dan)</p>
                <p><strong>Email:</strong> tomoko.muth@shorinjikempo.ch</p>
            </div>
        </div>

        <p class="mt-2">
            <a class="dojo-detail-link" href={localizePath('/muri', lang)}>En savoir plus sur le dojo de Muri →</a>
        </p>
    </div>
</Layout>

<style>
    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 20px;
    }
    h1, h2 {
        margin-bottom: 1rem;
        color: #111;
    }
    h2 {
        margin-top: 2rem;
    }
    .dojo-card {
        display: flex;
        gap: 2rem;
        margin-bottom: 2rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }
    .dojo-card img {
        width: 200px;
        height: 150px;
        object-fit: cover;
    }
    .dojo-info {
        padding: 1rem;
    }
    .dojo-detail-link {
        color: #c00;
        font-weight: 600;
        text-decoration: none;
    }
    .dojo-detail-link:hover {
        text-decoration: underline;
    }
</style>