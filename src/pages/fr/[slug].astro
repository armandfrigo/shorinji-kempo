---
import Layout from '../../layouts/Layout.astro';
import SlugRouteBody from '../../components/SlugRouteBody.astro';
import { getSlugStaticPaths } from '../../lib/get-slug-static-paths';
import { resolveSlugPage } from '../../lib/get-slug-page-data';
import { getSlugLayoutSeo } from '../../lib/slug-seo';

export async function getStaticPaths() {
  return getSlugStaticPaths();
}

const lang = 'fr';
const { slug } = Astro.params;

const result = await resolveSlugPage(slug!, lang);
if ('redirect' in result) {
  return Astro.redirect(result.redirect, 302);
}

const { Content, isSitePage, pageEntry, postEntry } = result;
const seo = await getSlugLayoutSeo(slug!, lang, pageEntry, postEntry);
---

<Layout
  lang={lang}
  title={seo.title}
  description={seo.description}
  hreflangLocales={seo.hreflangLocales}
>
  <SlugRouteBody isSitePage={isSitePage} pageEntry={pageEntry} postEntry={postEntry} lang={lang} routeSlug={slug!}>
    <Content />
  </SlugRouteBody>
</Layout>
