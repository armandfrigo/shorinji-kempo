---
import Layout from '../../layouts/Layout.astro';
import InstagramNewsCarousel from '../../components/InstagramNewsCarousel.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/paths.ts';

const posts = (await getCollection('news')).filter((p) => p.data.lang === 'fr');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout lang='fr'>
  <div class="mx-auto max-w-[1100px] px-5 py-8">
    <h1 class="mb-8 text-4xl text-neutral-900">Actualités</h1>

    <InstagramNewsCarousel lang="fr" />

    <div class="space-y-8">
      {posts.map((post) => (
        <article class="flex gap-6 border-b border-neutral-200 pb-8">
          {post.data.image ? (
            <img
              src={withBase(post.data.image)}
              alt={post.data.imageAlt ?? post.data.title}
              class="h-[100px] w-[150px] rounded object-cover"
              loading="lazy"
            />
          ) : null}

          <div class="min-w-0">
            <h2 class="mb-2 text-2xl text-red-700">{post.data.title}</h2>
            <p class="mb-2 text-sm text-neutral-600">
              {post.data.author ? `Par ${post.data.author} | ` : ''}
              {post.data.date.toLocaleDateString('fr-CH', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <p class="text-neutral-800">{post.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>