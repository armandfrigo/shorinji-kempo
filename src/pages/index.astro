---
import Layout from '../layouts/Layout.astro';
import InstagramFeed from '../components/InstagramFeed.jsx';
import { defaultLang, ui } from '../i18n/ui.ts';

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui.de;
---

<Layout lang={lang}>
    <div class="hero">
        <div class="container">
            <h1>{t['hero.title']}</h1>
            <p class="hero-text">
                {t['hero.text']}
            </p>
            <a href={lang === 'de' ? '/dojo' : `/${lang}/dojo`} class="btn">{t['hero.cta']}</a>
        </div>
    </div>

    <div class="container content">
        <h2>{t['section.about']}</h2>
        <p>{t['section.philosophy']}</p>
    </div>

    <div class="container">
        <h2>Instagram</h2>
        <InstagramFeed url="https://www.instagram.com/shorinjikempo.aubonne/" client:visible />
    </div>
</Layout>

<style>
    .hero {
        background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.75)),
                    url('images/juniperphoton-734577-unsplash-Kopie-1024x683.jpg');
        background-size: cover;
        background-position: center;
        color: white;
        padding: 160px 0 120px;
        text-align: center;
    }
    .hero-text {
        font-size: 1.35rem;
        max-width: 720px;
        margin: 0 auto 2rem;
    }
    .content {
        margin-top: 5rem;
        padding-bottom: 5rem;
    }
</style>