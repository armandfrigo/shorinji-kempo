---
import Navbar from '../components/navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { withBase } from '../utils/paths.ts';
import {
  absoluteSiteUrl,
  buildHreflangAlternates,
  DEFAULT_META_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  logicalPathForLocale,
  parseLocalePath,
  type HreflangLink,
  type SiteLocale,
} from '../utils/seo.ts';

interface Props {
  lang?: SiteLocale;
  title?: string;
  description?: string;
  /** When set, overrides auto hreflang (e.g. content pages grouped by routeSlug). */
  hreflangLocales?: SiteLocale[];
  ogImage?: string;
}

const props = Astro.props as Props;

// Pages pass explicit lang; prefer it over currentLocale (not always set for prefixed routes).
const lang = (props.lang ?? Astro.currentLocale ?? 'de') as SiteLocale;

const pageTitle =
  typeof props.title === 'string' && props.title.length > 0
    ? props.title
    : 'Schweizerische Shorinji Kempo Föderation';
const pageDescription =
  typeof props.description === 'string' && props.description.length > 0
    ? props.description
    : DEFAULT_META_DESCRIPTION;

const siteOrigin = (Astro.site?.href ?? import.meta.env.SITE ?? 'https://armandfrigo.github.io').replace(
  /\/$/,
  '',
);
const deployBase = import.meta.env.BASE_URL;

const { logicalPath } = parseLocalePath(Astro.url.pathname);

// Routes mirrored in all four locales: index, dojo, shorinji-kempo, aktuell.
const STATIC_I18N_PATHS = new Set(['/', '/dojo', '/shorinji-kempo', '/aktuell']);
const hreflangLocales: SiteLocale[] =
  props.hreflangLocales && props.hreflangLocales.length > 0
    ? props.hreflangLocales
    : STATIC_I18N_PATHS.has(logicalPath)
      ? (['de', 'fr', 'en', 'it'] as SiteLocale[])
      : [];

const hreflangLinks: HreflangLink[] =
  hreflangLocales.length > 0
    ? buildHreflangAlternates(logicalPath, hreflangLocales, siteOrigin, deployBase)
    : [];

const canonicalUrl = absoluteSiteUrl(logicalPathForLocale(logicalPath, lang), siteOrigin, deployBase);
const ogImageUrl = absoluteSiteUrl(
  props.ogImage ?? DEFAULT_OG_IMAGE,
  siteOrigin,
  deployBase,
);

const ogLocaleMap: Record<SiteLocale, string> = {
  de: 'de_CH',
  fr: 'fr_CH',
  en: 'en_US',
  it: 'it_CH',
};

/** Subtle Figma texture (same asset as homepage hero); CSS url() with base-safe path. */
const mainBgTexture = `url(${JSON.stringify(withBase('/uploads/2019/09/2019-04-21-14_26_56-Shorinji-Kempo-Entwurf-Figma-1024x575.png'))})`;

// PNG favicons under public/images/favicons (deploy base via withBase).
const faviconPngSizes = [16, 32, 48, 64, 128, 256] as const;
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    {
      faviconPngSizes.map((size) => (
        <link
          rel="icon"
          type="image/png"
          sizes={`${size}x${size}`}
          href={withBase(`/images/favicons/favicon_${size}x${size}.png`)}
        />
      ))
    }
    <link rel="apple-touch-icon" href={withBase('/images/favicons/favicon_256x256.png')} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Schweizerische Shorinji Kempo Föderation" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
</head>
<body class="site-shell">
    <header class="site-header">
        <Navbar lang={lang} currentPath={Astro.url.pathname} />
    </header>

    <main class="site-main">
        <slot />
    </main>

    <Footer lang={lang} />
</body>
</html>

<style is:global define:vars={{ mainBgTexture }}>
  body.site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--sk-body-bg);
  }
  body.site-shell > main.site-main {
    flex: 1 1 auto;
    position: relative;
    padding-inline: var(--container-padding-inline);
    /* Background painted in two layers: the left-to-right white gradient sits ON TOP of the
       Figma texture so body copy stays readable while the artwork hugs the right edge. */
    background-image:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.94) 0%,
        rgba(255, 255, 255, 0.78) 35%,
        rgba(255, 255, 255, 0.38) 62%,
        rgba(255, 255, 255, 0) 88%
      ),
      var(--mainBgTexture);
    background-repeat: no-repeat, no-repeat;
    background-position: left center, right center;
    background-size: 100% 100%, min(60vw, 720px) auto;
    background-attachment: scroll, fixed;
  }
  /* Width constraint only — horizontal gutters come from `.site-main`. */
  body.site-shell > main.site-main .container {
    padding-inline: 0;
  }
  body.site-shell > main.site-main > .hero .container,
  body.site-shell > main.site-main > section.hero .container {
    padding-inline: var(--container-padding-inline);
  }
  /* Full-bleed heroes escape main gutters; inner `.hero-container` keeps text inset. */
  body.site-shell > main.site-main > .hero,
  body.site-shell > main.site-main > section.hero {
    margin-inline: calc(-1 * var(--container-padding-inline));
    width: calc(100% + 2 * var(--container-padding-inline));
    max-width: 100vw;
  }
  @media (max-width: 768px) {
    body.site-shell > main.site-main {
      /* On narrow screens, keep the artwork visible but lighter so it doesn't fight the text. */
      background-size: 100% 100%, min(90vw, 520px) auto;
      background-position: left center, right top;
      background-attachment: scroll, scroll;
    }
  }
</style>
