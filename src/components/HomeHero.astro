---
import { ui, languages } from '../i18n/ui.ts';
import { withBase } from '../utils/paths.ts';
import { CONTACT_FORM_ANCHOR } from '../utils/heroTrialMailto.ts';

type Lang = keyof typeof languages;

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const heroBgUrl = `url('${withBase('/uploads/2019/09/2019-04-21-14_26_56-Shorinji-Kempo-Entwurf-Figma-1024x575.png')}')`;
---

<div class="hero">
  <div class="container">
    <h1>{t['hero.title']}</h1>
    <p class="hero-text">{t['hero.text']}</p>
    <a class="hero-cta" href={CONTACT_FORM_ANCHOR}>{t['hero.cta']}</a>
  </div>
</div>

<style define:vars={{ heroBgUrl }}>
  .hero {
    background-image: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.75)), var(--heroBgUrl);
    background-size: cover;
    background-position: center;
    color: white;
    padding: clamp(4.5rem, 9vw, 7rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    text-align: center;
  }
  .hero-text {
    font-size: 1.35rem;
    max-width: 720px;
    margin: 0 auto 2rem;
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.25rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    text-decoration: none;
    color: #fff;
    background: #c00;
    border: 2px solid rgba(255, 255, 255, 0.45);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .hero-cta:hover {
    background: #d40000;
    border-color: #fff;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
    transform: translateY(-1px);
  }
  .hero-cta:focus-visible {
    outline: none;
    border-color: #fff;
    box-shadow:
      0 0 0 2px #111,
      0 0 0 5px #fff,
      0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .hero-cta:active {
    transform: translateY(0);
  }
  @media (max-width: 767px) {
    .hero {
      padding: 4rem 0 3.25rem;
    }
  }
</style>
