---
// src/components/FooterSocial.astro
// Footer with national + dojo-specific social media

export interface Props {
  lang: 'de' | 'fr' | 'en' | 'it';
  dojoName?: 'basel' | 'aubonne' | 'muri'; // Optional - if on a dojo page
}

const { lang = 'de', dojoName } = Astro.props;

// Social links mapping
const socialLinks = {
  national: {
    facebook: 'https://www.facebook.com/ShorinjiKempoSchweiz/',
    wsko: 'https://www.shorinjikempo.or.jp/wsko/'
  },
  basel: {
    instagram: 'https://www.instagram.com/shorinjikempo.basel/',
    contact: 'mailto:marco.pellegrino@shorinjikempo.ch'
  },
  aubonne: {
    instagram: 'https://www.instagram.com/shorinjikempo.aubonne/',
    contact: 'mailto:comino.roberto@gmail.com'
  },
  muri: {
    instagram: 'https://www.instagram.com/shorinjikempo.muri/',
    contact: 'mailto:tomoko.muth@shorinjikempo.ch'
  }
};

const copy = {
  de: {
    followUs: 'Folge uns',
    national: 'Schweiz',
    dojo: 'Dojo',
    copyright: '© 2026 Shorinji Kempo Schweiz',
    allRightsReserved: 'Alle Rechte vorbehalten',
    visitWsko: 'WSKO besuchen'
  },
  fr: {
    followUs: 'Nous suivre',
    national: 'Suisse',
    dojo: 'Dojo',
    copyright: '© 2026 Shorinji Kempo Suisse',
    allRightsReserved: 'Tous droits réservés',
    visitWsko: 'Visiter WSKO',
    quickLinks: 'Liens rapides',
    home: 'Accueil',
    philosophy: 'Philosophie',
    dojos: 'Dojos',
    resources: 'Ressources',
    contact: 'Nous contacter',
    contactLabel: 'Contacter',
  },
  en: {
    followUs: 'Follow us',
    national: 'Switzerland',
    dojo: 'Dojo',
    copyright: '© 2026 Shorinji Kempo Switzerland',
    allRightsReserved: 'All rights reserved',
    visitWsko: 'Visit WSKO',
    quickLinks: 'Quick links',
    home: 'Home',
    philosophy: 'Philosophy',
    dojos: 'Dojos',
    resources: 'Resources',
    contact: 'Contact us',
    contactLabel: 'Contact',
  },
  it: {
    followUs: 'Seguici',
    national: 'Svizzera',
    dojo: 'Dojo',
    copyright: '© 2026 Shorinji Kempo Svizzera',
    allRightsReserved: 'Tutti i diritti riservati',
    visitWsko: 'Visita WSKO',
    quickLinks: 'Link rapidi',
    home: 'Home',
    philosophy: 'Filosofia',
    dojos: 'Dojo',
    resources: 'Risorse',
    contact: 'Contattaci',
    contactLabel: 'Contatta',
  },
};

const deCopy = {
  ...copy.de,
  quickLinks: 'Schnelllinks',
  home: 'Startseite',
  philosophy: 'Philosophie',
  dojos: 'Dojos',
  resources: 'Ressourcen',
  contact: 'Kontakt',
  contactLabel: 'Kontaktieren',
};

const t = lang === 'de' ? deCopy : copy[lang] || deCopy;
const dojoSocial = dojoName ? socialLinks[dojoName] : null;
---

<footer class="footer-social">
  <div class="container">
    <div class="footer-content">
      <!-- Main Links -->
      <div class="footer-column">
        <h4>{t.followUs}</h4>
        
        <!-- National Social -->
        <div class="social-section">
          <p class="social-label">{t.national}</p>
          <div class="social-links">
            {socialLinks.national.facebook && (
              <a href={socialLinks.national.facebook} target="_blank" rel="noopener noreferrer" class="social-link">
                📘 Facebook
              </a>
            )}
            {socialLinks.national.wsko && (
              <a href={socialLinks.national.wsko} target="_blank" rel="noopener noreferrer" class="social-link">
                🌍 {t.visitWsko}
              </a>
            )}
          </div>
        </div>

        <!-- Dojo-Specific Social (if on a dojo page) -->
        {dojoSocial && (
          <div class="social-section">
            <p class="social-label">{t.dojo} {dojoName?.charAt(0).toUpperCase()}{dojoName?.slice(1)}</p>
            <div class="social-links">
              {dojoSocial.instagram && (
                <a href={dojoSocial.instagram} target="_blank" rel="noopener noreferrer" class="social-link">
                  📸 Instagram
                </a>
              )}
              {dojoSocial.contact && (
                <a href={dojoSocial.contact} class="social-link">
                  ✉️ {t.contactLabel}
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <!-- Quick Links -->
      <div class="footer-column">
        <h4>{t.quickLinks}</h4>
        <ul class="footer-links">
          <li><a href={lang === 'de' ? '/' : `/${lang}/`}>{t.home}</a></li>
          <li><a href={lang === 'de' ? '/philosophie' : `/${lang}/philosophie`}>{t.philosophy}</a></li>
          <li><a href={lang === 'de' ? '/dojo' : `/${lang}/dojo`}>{t.dojos}</a></li>
          <li><a href={lang === 'de' ? '/faq' : `/${lang}/faq`}>FAQ</a></li>
          <li><a href={lang === 'de' ? '/links' : `/${lang}/links`}>{t.resources}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="footer-column">
        <h4>{t.contact}</h4>
        <p class="contact-info">
          {t.national}
        </p>
        <a href="mailto:contact@shorinjikempo.ch" class="footer-email">
          contact@shorinjikempo.ch
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p>
        {t.copyright} • {t.allRightsReserved}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    background: var(--color-black);
    color: var(--color-white);
    padding: var(--space-3xl) 0 var(--space-2xl);
    margin-top: var(--space-3xl);
    border-top: 1px solid var(--color-grey-dark);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .footer-column h4 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-lg);
    color: var(--color-white);
    font-weight: 600;
  }

  .footer-column p {
    color: var(--color-grey-light);
    font-size: var(--font-size-sm);
  }

  .social-section {
    margin-bottom: var(--space-lg);
  }

  .social-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-grey-mid);
    margin-bottom: var(--space-sm);
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .social-link {
    color: var(--color-red-accent);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .social-link:hover {
    color: var(--color-white);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-links a {
    color: var(--color-grey-light);
    text-decoration: none;
    font-size: var(--font-size-sm);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-red-accent);
  }

  .contact-info {
    color: var(--color-grey-light);
    margin-bottom: var(--space-md);
  }

  .footer-email {
    color: var(--color-red-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .footer-email:hover {
    color: var(--color-white);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-grey-dark);
    padding-top: var(--space-lg);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--color-grey-mid);
    font-size: var(--font-size-xs);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
