---
import HeroPremium from './HeroPremium.astro';
import DojoCard from './DojoCard.astro';
import ContactForm from './ContactForm.astro';
import { homeCopy, homeDojos, type HomeLang } from '../i18n/homePage';
import { withBase, localizePath } from '../utils/paths';

export interface Props {
  lang: HomeLang;
}

const { lang } = Astro.props;
const t = homeCopy[lang];
const dojos = homeDojos[lang];
---

<HeroPremium
  lang={lang}
  title={t.hero.title}
  subtitle={t.hero.subtitle}
  ctaText={t.hero.cta}
  footerNote={t.hero.footer}
  ctaHref={localizePath('/#contact', lang)}
  imageUrl={withBase('/images/hero-main.jpg')}
  imageAlt="Shorinji Kempo Training"
/>

<section class="philosophy-intro">
  <div class="container">
    <div class="philosophy-content">
      <h2>{t.philosophy.heading}</h2>
      <p class="intro-text">{t.philosophy.intro}</p>

      <div class="benefits-list">
        {t.philosophy.benefits.map((benefit) => (
          <div class="benefit-item">
            <span class="benefit-icon">✓</span>
            <p>{benefit}</p>
          </div>
        ))}
      </div>

      <a href={localizePath('/philosophie', lang)} class="btn btn-outline">
        {t.philosophy.learnMore} →
      </a>
    </div>
  </div>
</section>

<section class="dojos-section">
  <div class="container">
    <div class="section-header">
      <h2>{t.dojos.heading}</h2>
      <p class="section-subtitle">{t.dojos.subheading}</p>
    </div>

    <div class="dojos-grid">
      {dojos.map((dojo) => (
        <DojoCard lang={lang} {...dojo} href={localizePath(`/${dojo.slug}`, lang)} />
      ))}
    </div>

    <div class="dojos-cta">
      <a href={localizePath('/dojo', lang)} class="btn btn-secondary">
        {t.dojos.viewAll}
      </a>
    </div>
  </div>
</section>

<section class="why-join">
  <div class="container">
    <h2 class="text-center mb-4">{t.whyJoin.heading}</h2>

    <div class="reasons-grid">
      {t.whyJoin.reasons.map((reason) => (
        <div class="reason-card">
          <div class="reason-icon">{reason.icon}</div>
          <h3>{reason.title}</h3>
          <p>{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq-preview">
  <div class="container">
    <h2 class="text-center mb-4">{t.faqPreview.heading}</h2>

    <div class="faq-list">
      {t.faqPreview.questions.map((item) => (
        <div class="faq-item">
          <h4 class="faq-question">{item.q}</h4>
          <p class="faq-answer">{item.a}</p>
        </div>
      ))}
    </div>

    <div class="faq-cta text-center mt-3">
      <a href={localizePath('/faq', lang)} class="btn btn-primary">
        {t.faqPreview.viewAll} →
      </a>
    </div>
  </div>
</section>

<section class="cta-final">
  <div class="container text-center">
    <h2>{t.cta.heading}</h2>
    <p class="cta-subheading">{t.cta.subheading}</p>
    <a href={localizePath('/#contact', lang)} class="btn btn-primary btn-large">
      {t.cta.button} →
    </a>
  </div>
</section>

<ContactForm lang={lang} />

<style>
  .philosophy-intro {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, #fafaf8 0%, #f5f5f2 100%);
  }

  .philosophy-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .philosophy-content h2 {
    margin-bottom: var(--space-lg);
  }

  .intro-text {
    font-size: var(--font-size-lg);
    color: var(--color-grey-dark);
    margin-bottom: var(--space-2xl);
    line-height: 1.8;
  }

  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
    text-align: left;
  }

  .benefit-item {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .benefit-icon {
    color: var(--color-red-deep);
    font-weight: bold;
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .benefit-item p {
    margin: 0;
    text-align: left;
  }

  .dojos-section {
    padding: var(--space-3xl) 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header h2 {
    margin-bottom: var(--space-sm);
  }

  .section-subtitle {
    color: var(--color-grey-mid);
    font-size: var(--font-size-lg);
  }

  .dojos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .dojos-cta {
    text-align: center;
  }

  .why-join {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, #fafaf8 0%, #f5f5f2 100%);
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-2xl);
  }

  .reason-card {
    background: var(--color-white);
    padding: var(--space-2xl);
    border-radius: 2px;
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: all var(--transition-base);
  }

  .reason-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .reason-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-md);
    display: block;
  }

  .reason-card h3 {
    margin-bottom: var(--space-sm);
    font-size: var(--font-size-lg);
  }

  .reason-card p {
    color: var(--color-grey-dark);
    font-size: var(--font-size-sm);
    margin: 0;
  }

  .faq-preview {
    padding: var(--space-3xl) 0;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto var(--space-2xl);
  }

  .faq-item {
    background: linear-gradient(135deg, #fafaf8 0%, #f5f5f2 100%);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    border-radius: 2px;
    border-left: 3px solid var(--color-red-deep);
  }

  .faq-question {
    color: var(--color-black);
    margin-bottom: var(--space-sm);
    font-size: var(--font-size-base);
    font-weight: 600;
  }

  .faq-answer {
    color: var(--color-grey-dark);
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  .faq-cta {
    text-align: center;
  }

  .cta-final {
    padding: var(--space-3xl) 0;
    background: linear-gradient(135deg, #fafaf8 0%, #f5f5f2 100%);
  }

  .cta-final h2 {
    margin-bottom: var(--space-md);
  }

  .cta-subheading {
    color: var(--color-grey-dark);
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-lg);
  }

  .btn-large {
    padding: var(--space-lg) var(--space-2xl);
    font-size: var(--font-size-base);
  }

  .text-center {
    text-align: center;
  }

  .mb-4 {
    margin-bottom: var(--space-2xl);
  }

  .mt-3 {
    margin-top: var(--space-lg);
  }

  @media (max-width: 768px) {
    .philosophy-intro,
    .dojos-section,
    .why-join,
    .faq-preview,
    .cta-final {
      padding: var(--space-2xl) 0;
    }

    .dojos-grid {
      grid-template-columns: 1fr;
    }

    .reasons-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
