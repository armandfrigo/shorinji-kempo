---
import { languages, ui, defaultLang } from '../i18n/ui.ts';
import { stripBaseFromPath, withBase } from '../utils/paths.ts';

const { lang = defaultLang, currentPath = '/' } = Astro.props;

const t = ui[lang] || ui.de;

const getCleanPath = (path: string): string => {
  return path.replace(/^\/(fr|en|it)\//, '/').replace(/^\/(fr|en|it)$/, '/');
};

const pathWithoutBase = stripBaseFromPath(currentPath);
const cleanPath = getCleanPath(pathWithoutBase);

const localizePath = (path: string): string => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  if (lang === 'de') return withBase(normalized);
  if (normalized === '/') return withBase(`/${lang}`);
  return withBase(`/${lang}${normalized}`);
};

const isActive = (targetPath: string): boolean => {
  if (targetPath === '/') return cleanPath === '/';
  return cleanPath === targetPath || cleanPath.startsWith(`${targetPath}/`);
};

const aboutPath = '/shorinji-kempo';
const dojoPaths = ['/dojo', '/basel', '/aubonne', '/muri'];
const mailHref = 'mailto:marco.pellegrino@shorinjikempo.ch';
const logoSrc = withBase('/uploads/2019/09/ATT45591-300x227.jpg');
---

<nav class="navbar">
    <div class="container">
        <a href={localizePath('/')} class="logo">
            <img class="logo-img" src={logoSrc} alt="" width="60" height="45" decoding="async" />
            <span class="logo-title">{t['nav.siteTitle']}</span>
        </a>

        <button class="mobile-menu-btn" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links">
            <a href={localizePath('/')} class={`nav-item ${isActive('/') ? 'active' : ''}`}>
                {t['nav.home']}
            </a>
            <a href={localizePath(aboutPath)} class={`nav-item ${isActive(aboutPath) ? 'active' : ''}`}>
                {t['nav.about']}
            </a>
            <a
                href={localizePath('/dojo')}
                class={`nav-item ${dojoPaths.some((p) => isActive(p)) ? 'active' : ''}`}
            >
                {t['nav.findDojo']}
            </a>
            <a href={localizePath('/faq')} class={`nav-item ${isActive('/faq') ? 'active' : ''}`}>
                {t['nav.faq']}
            </a>
            <a href={mailHref} class="nav-item">
                {t['nav.contact']}
            </a>
        </div>

        <div class="language-switcher">
            {Object.entries(languages).map(([code]) => {
                const href =
                    code === 'de'
                        ? withBase(cleanPath)
                        : withBase(cleanPath === '/' ? `/${code}` : `/${code}${cleanPath}`);
                return (
                    <a
                        href={href}
                        class={`lang-btn ${lang === code ? 'active' : ''}`}
                    >
                        {code.toUpperCase()}
                    </a>
                );
            })}
        </div>
    </div>
</nav>

<style>
    .navbar {
        background: var(--sk-header-bg, #fff);
        color: var(--sk-header-text, #111);
        padding: 0.75rem 0;
        position: sticky;
        top: 0;
        z-index: 100;
        border-bottom: 1px solid var(--sk-header-border, #e5e5e5);
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03);
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }
    .logo {
        font-size: 1.3rem;
        font-weight: bold;
        color: var(--sk-header-text, #111);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }
    .logo-title {
        min-width: 0;
        line-height: 1.25;
        hyphens: auto;
    }
    .logo-img {
        display: block;
        height: 36px;
        width: auto;
        object-fit: contain;
    }
    .logo:focus-visible {
        outline: 2px solid var(--sk-header-focus-ring, #111);
        outline-offset: 4px;
        border-radius: 4px;
    }
    .mobile-menu-btn {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
    }
    .mobile-menu-btn span {
        width: 24px;
        height: 2px;
        background: var(--sk-header-text, #111);
        transition: 0.3s;
    }
    .mobile-menu-btn:focus-visible {
        outline: 2px solid var(--sk-header-focus-ring, #111);
        outline-offset: 3px;
        border-radius: 4px;
    }
    .nav-links {
        display: flex;
        gap: 1.25rem;
        align-items: center;
        position: relative;
        flex-wrap: wrap;
    }
    .nav-item {
        color: var(--sk-header-text, #111);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .nav-item:focus-visible {
        outline: 2px solid var(--sk-header-focus-ring, #111);
        outline-offset: 4px;
        border-radius: 2px;
    }
    .nav-item.active {
        color: var(--sk-accent, #c00);
    }
    .nav-item:hover {
        color: var(--sk-accent, #c00);
    }
    .language-switcher {
        display: flex;
        gap: 4px;
    }
    .lang-btn {
        padding: 4px 8px;
        border: 1px solid var(--sk-header-border, #e5e5e5);
        color: var(--sk-header-text, #111);
        text-decoration: none;
        font-size: 0.75rem;
        border-radius: 3px;
    }
    .lang-btn:focus-visible {
        outline: 2px solid var(--sk-header-focus-ring, #111);
        outline-offset: 2px;
    }
    .lang-btn:hover, .lang-btn.active {
        background: var(--sk-accent, #c00);
        border-color: var(--sk-accent, #c00);
        color: #fff;
    }

    @media (max-width: 768px) {
        .logo {
            font-size: 1rem;
            flex: 1 1 0;
        }
        .mobile-menu-btn {
            display: flex;
        }
        .nav-links {
            display: none;
            flex-direction: column;
            align-items: flex-start;
            width: 100%;
            margin-top: 1rem;
            gap: 0.5rem;
            padding: 0.5rem 0;
            border-top: 1px solid var(--sk-header-border, #e5e5e5);
        }
        .nav-links.active {
            display: flex;
        }
        .language-switcher {
            margin-top: 0.5rem;
            width: 100%;
            justify-content: center;
            border-top: 1px solid var(--sk-header-border, #e5e5e5);
            padding-top: 0.5rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.querySelector('.mobile-menu-btn');
        const navLinks = document.querySelector('.nav-links');

        menuBtn?.addEventListener('click', () => {
            navLinks?.classList.toggle('active');
        });
    });
</script>
