---
import { languages, ui, defaultLang } from '../i18n/ui.ts';
import { stripBaseFromPath, withBase } from '../utils/paths.ts';

const { lang = defaultLang, currentPath = '/' } = Astro.props;

const t = ui[lang] || ui.de;

const getCleanPath = (path: string): string => {
  return path.replace(/^\/(fr|en|it)\//, '/').replace(/^\/(fr|en|it)$/, '/');
};

const pathWithoutBase = stripBaseFromPath(currentPath);
const cleanPath = getCleanPath(pathWithoutBase);

const localizePath = (path: string): string => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  if (lang === 'de') return withBase(normalized);
  if (normalized === '/') return withBase(`/${lang}`);
  return withBase(`/${lang}${normalized}`);
};

const isActive = (targetPath: string): boolean => {
  if (targetPath === '/') return cleanPath === '/';
  return cleanPath === targetPath || cleanPath.startsWith(`${targetPath}/`);
};

const shorinjiPaths = [
  '/entstehung',
  '/gruender',
  '/shorinji-kempo',
  '/techniken',
  '/vorstand',
];

const dojoPaths = ['/dojo', '/basel', '/aubonne', '/muri'];
const logoSrc = withBase('/uploads/2019/09/ATT45591-300x227.jpg');
---

<nav class="navbar">
    <div class="container">
        <a href={localizePath('/')} class="logo">
            <img class="logo-img" src={logoSrc} alt="" width="60" height="45" decoding="async" />
            <span class="logo-title">{t['nav.siteTitle']}</span>
        </a>

        <button class="mobile-menu-btn" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-links">
            <a href={localizePath('/')} class={`nav-item ${isActive('/') ? 'active' : ''}`}>
                {t['nav.home']}
            </a>

            <div class="dropdown">
                <a href="#" class={`nav-item dropdown-toggle ${shorinjiPaths.some(isActive) ? 'active' : ''}`}>
                    {t['nav.shorinji']}
                </a>
                <div class="dropdown-menu">
                    <a href={localizePath('/entstehung')} class="dropdown-item">{t['nav.entstehung']}</a>
                    <a href={localizePath('/gruender')} class="dropdown-item">{t['nav.gruender']}</a>
                    <a href={localizePath('/shorinji-kempo')} class="dropdown-item">{t['nav.philosophie']}</a>
                    <a href={localizePath('/techniken')} class="dropdown-item">{t['nav.techniken']}</a>
                    <a href={localizePath('/vorstand')} class="dropdown-item">{t['nav.vorstand']}</a>
                </div>
            </div>

            <div class="dropdown">
                <a href="#" class={`nav-item dropdown-toggle ${dojoPaths.some(isActive) ? 'active' : ''}`}>
                    {t['nav.dojo']}
                </a>
                <div class="dropdown-menu">
                    <a href={localizePath('/dojo')} class="dropdown-item">{t['nav.dojo.all']}</a>
                    <a href={localizePath('/basel')} class="dropdown-item">{t['nav.dojo.basel']}</a>
                    <a href={localizePath('/aubonne')} class="dropdown-item">{t['nav.dojo.aubonne']}</a>
                    <a href={localizePath('/muri')} class="dropdown-item">{t['nav.dojo.muri']}</a>
                </div>
            </div>

            <a href={localizePath('/aktuell')} class={`nav-item ${isActive('/aktuell') ? 'active' : ''}`}>
                {t['nav.news']}
            </a>
            <a href={localizePath('/links')} class={`nav-item ${isActive('/links') ? 'active' : ''}`}>
                {t['nav.links']}
            </a>
        </div>

        <div class="language-switcher">
            {Object.entries(languages).map(([code]) => {
                const href =
                    code === 'de'
                        ? withBase(cleanPath)
                        : withBase(cleanPath === '/' ? `/${code}` : `/${code}${cleanPath}`);
                return (
                    <a
                        href={href}
                        class={`lang-btn ${lang === code ? 'active' : ''}`}
                    >
                        {code.toUpperCase()}
                    </a>
                );
            })}
        </div>
    </div>
</nav>

<style>
    .navbar {
        background: var(--sk-header-bg, #111);
        color: white;
        padding: 0.75rem 0;
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }
    .logo {
        font-size: 1.3rem;
        font-weight: bold;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }
    .logo-title {
        min-width: 0;
        line-height: 1.25;
        hyphens: auto;
    }
    .logo-img {
        display: block;
        height: 36px;
        width: auto;
        object-fit: contain;
    }
    .mobile-menu-btn {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
    }
    .mobile-menu-btn span {
        width: 24px;
        height: 2px;
        background: white;
        transition: 0.3s;
    }
    .nav-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        position: relative;
    }
    .dropdown {
        position: relative;
    }
    .dropdown-toggle {
        cursor: pointer;
    }
    .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        background: white;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        min-width: 200px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s ease;
        z-index: 1000;
    }
    .dropdown:hover .dropdown-menu,
    .dropdown-menu.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .dropdown-item {
        display: block;
        padding: 0.75rem 1rem;
        color: #333;
        text-decoration: none;
        border-bottom: 1px solid #eee;
    }
    .dropdown-item:last-child {
        border-bottom: none;
    }
    .dropdown-item:hover {
        background: #f8f9fa;
        color: var(--sk-accent, #c00);
    }
    .nav-item {
        color: white;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        white-space: nowrap;
    }
    .nav-item.active {
        color: var(--sk-accent, #c00);
    }
    .nav-item:hover {
        color: var(--sk-accent, #c00);
    }
    .language-switcher {
        display: flex;
        gap: 4px;
    }
    .lang-btn {
        padding: 4px 8px;
        border: 1px solid #555;
        color: white;
        text-decoration: none;
        font-size: 0.75rem;
        border-radius: 3px;
    }
    .lang-btn:hover, .lang-btn.active {
        background: var(--sk-accent, #c00);
        border-color: var(--sk-accent, #c00);
    }

    /* Mobile styles */
    @media (max-width: 768px) {
        .logo {
            font-size: 1rem;
            flex: 1 1 0;
        }
        .mobile-menu-btn {
            display: flex;
        }
        .nav-links {
            display: none;
            flex-direction: column;
            width: 100%;
            margin-top: 1rem;
            gap: 0.5rem;
            padding: 0.5rem 0;
            border-top: 1px solid #333;
        }
        .nav-links.active {
            display: flex;
        }
        .dropdown-menu {
            position: static;
            opacity: 1;
            visibility: visible;
            transform: none;
            box-shadow: none;
            border: none;
            background: rgba(255,255,255,0.1);
            margin-left: 1rem;
            margin-top: 0.5rem;
            border-left: 2px solid var(--sk-accent, #c00);
        }
        .dropdown-item {
            color: #ddd;
            padding: 0.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        .dropdown-item:hover {
            background: rgba(255,255,255,0.1);
            color: var(--sk-accent, #c00);
        }
        .language-switcher {
            margin-top: 0.5rem;
            width: 100%;
            justify-content: center;
            border-top: 1px solid #333;
            padding-top: 0.5rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.querySelector('.mobile-menu-btn');
        const navLinks = document.querySelector('.nav-links');
        
        menuBtn?.addEventListener('click', () => {
            navLinks?.classList.toggle('active');
        });
    });
</script>
