---
import { defaultLang, ui } from '../i18n/ui.ts';

type Lang = keyof typeof ui;

const { lang = defaultLang } = Astro.props;
const locale = (lang in ui ? lang : defaultLang) as Lang;
const t = ui[locale];

const year = new Date().getFullYear();

const hrefWsko = 'https://www.shorinjikempo.or.jp/wsko/';
const hrefImprint = 'https://shorinjikempo.ch/index.php/startseite/impressum/';
const hrefPrivacy = 'https://shorinjikempo.ch/index.php/startseite/datenschutzerklaerung/';
/** Same URL as `src/pages/links.astro` and documentation. */
const hrefFacebook = 'https://www.facebook.com/ShorinjiKempoSchweiz/';
const telHref = 'tel:+41796365682';
const mailHref = 'mailto:marco.pellegrino@shorinjikempo.ch';
const mailDisplay = 'Marco.pellegrino@shorinjikempo.ch';
const phoneDisplay = '+41 79 636 56 82';
---

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <section class="site-footer__block" aria-labelledby="footer-contact-heading">
                <h2 id="footer-contact-heading" class="site-footer__heading">{t['footer.contactHeading']}</h2>
                <div class="site-footer__rows">
                    <div class="site-footer__row">
                        <span class="site-footer__icon" aria-hidden="true">
                            <svg class="site-footer__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <span class="site-footer__row-text">{t['footer.contactName']}</span>
                    </div>
                    <div class="site-footer__row">
                        <span class="site-footer__icon" aria-hidden="true">
                            <svg class="site-footer__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                            </svg>
                        </span>
                        <a class="site-footer__link" href={telHref}>{phoneDisplay}</a>
                    </div>
                    <div class="site-footer__row">
                        <span class="site-footer__icon" aria-hidden="true">
                            <svg class="site-footer__svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="16" x="2" y="4" rx="2" />
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                            </svg>
                        </span>
                        <a class="site-footer__link" href={mailHref}>{mailDisplay}</a>
                    </div>
                </div>
            </section>

            <section class="site-footer__block" aria-labelledby="footer-links-heading">
                <h2 id="footer-links-heading" class="site-footer__heading">{t['footer.moreLinks']}</h2>
                <ul class="site-footer__linklist">
                    <li>
                        <a class="site-footer__link" href={hrefWsko} target="_blank" rel="noopener noreferrer">{t['footer.linkWsko']}</a>
                    </li>
                    <li>
                        <a class="site-footer__link" href={hrefImprint} target="_blank" rel="noopener noreferrer">{t['footer.linkImprint']}</a>
                    </li>
                    <li>
                        <a class="site-footer__link" href={hrefPrivacy} target="_blank" rel="noopener noreferrer">{t['footer.linkPrivacy']}</a>
                    </li>
                </ul>
            </section>

            <section class="site-footer__block site-footer__block--social" aria-labelledby="footer-fb-heading">
                <h2 id="footer-fb-heading" class="site-footer__heading">{t['footer.facebookInvite']}</h2>
                <a class="site-footer__fb-row site-footer__link" href={hrefFacebook} target="_blank" rel="noopener noreferrer">
                    <span class="site-footer__fb-badge" aria-hidden="true">
                        <svg class="site-footer__fb-svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                            <rect width="24" height="24" rx="5" fill="currentColor" />
                            <path
                                fill="#fff"
                                d="M13.5 22v-9h3l.5-4h-3.5V7.3c0-1 .3-1.7 1.7-1.7H17V2.1C16.6 2 15.5 2 14.3 2c-2.7 0-4.5 1.6-4.5 4.7V9H7v4h2.8v9h3.7z"
                            />
                        </svg>
                    </span>
                    <span>{t['footer.facebookPageName']}</span>
                </a>
            </section>
        </div>

        <div class="site-footer__bottom">
            <p>© {year} {t['footer.copyrightOrg']}</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        --footer-fg: #000;
        --footer-muted: #444;
        --footer-border: #ddd;

        background: #fff;
        color: var(--footer-fg);
        padding: 2.5rem 0 1.25rem;
        margin-top: 4rem;
        border-top: 1px solid var(--footer-border);
        font-family: 'Source Sans Pro', system-ui, sans-serif;
    }

    .site-footer :is(h1, h2, h3) {
        font-family: 'Source Sans Pro', system-ui, sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .site-footer__grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: 1fr;
    }

    @media (min-width: 768px) {
        .site-footer__grid {
            grid-template-columns: 1fr 1fr 1fr;
            gap: 2rem 2.5rem;
            align-items: start;
        }
    }

    .site-footer__heading {
        margin: 0 0 1rem;
        font-size: clamp(1.125rem, 2.5vw, 1.375rem);
        font-weight: 700;
        color: var(--footer-fg);
        line-height: 1.25;
    }

    .site-footer__rows {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.9375rem;
    }

    .site-footer__row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 1.5rem;
        min-width: 0;
    }

    .site-footer__icon {
        flex: 0 0 auto;
        flex-shrink: 0;
        width: 1.25rem;
        height: 1.25rem;
        max-width: 1.25rem;
        max-height: 1.25rem;
        color: var(--footer-fg);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .site-footer__svg {
        width: 1.25rem;
        height: 1.25rem;
        max-width: 100%;
        max-height: 100%;
        flex-shrink: 0;
        display: block;
    }

    .site-footer__row-text {
        line-height: 1.4;
    }

    .site-footer__link {
        color: var(--footer-fg);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .site-footer__link:hover {
        opacity: 0.75;
    }

    .site-footer__linklist {
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 0.9375rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .site-footer__fb-row {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        text-decoration: underline;
        font-size: 0.9375rem;
    }

    .site-footer__fb-badge {
        flex: 0 0 auto;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.5rem;
        height: 1.5rem;
        max-width: 1.5rem;
        max-height: 1.5rem;
        color: #000;
        overflow: hidden;
    }

    .site-footer__fb-svg {
        width: 1.5rem;
        height: 1.5rem;
        max-width: 100%;
        max-height: 100%;
        flex-shrink: 0;
        display: block;
    }

    .site-footer__bottom {
        border-top: 1px solid var(--footer-border);
        margin-top: 1rem;
        padding-top: 1.25rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--footer-muted);
    }

    .site-footer__bottom p {
        margin: 0;
    }
</style>
